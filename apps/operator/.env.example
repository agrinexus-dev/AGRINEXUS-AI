# Auth.js session signing/encryption secret.
# Generate a local value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-generated-secret

# AURA AI — Gemini provider (server-only; never expose to the client, never
# prefix with NEXT_PUBLIC_). Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# AgriNexus AI MVP-3A (AURA Provider & Model Router) — optional SECOND
# Gemini key, for a second independent Gemini endpoint (e.g. a different
# model, or simply a separate quota) in the Operator's AURA Router
# ("gemini-2" in lib/aura/router/endpoint-registry.ts). Leave unset if you
# only have one Gemini key — that endpoint will show as not-configured in
# the Operator AURA Router panel, and the router simply skips it.
GEMINI_2_API_KEY=

# AgriNexus AI MVP-3A.1 (AURA Router — Live Gemini Verification) — optional
# THIRD Gemini key ("gemini-3" in lib/aura/router/endpoint-registry.ts),
# same rules as GEMINI_2_API_KEY above — a genuinely independent key/quota,
# not a workaround for any single key's rate limit.
GEMINI_3_API_KEY=

# AgriNexus AI MVP-3C.0 (AURA Multi-Key, Multi-Model & Capability-Aware
# Provider Pool) — optional FOURTH Gemini key, same rules as GEMINI_2/3
# above. The Operator "Add Model" flow only offers a credential once its
# env var is actually set — adding a fifth (GEMINI_5_API_KEY) later needs
# only a new env var here plus one line in
# lib/aura/router/model-catalog.ts's GEMINI_CATALOG.credentialEnvVars, never
# a new routing branch or a second adapter implementation.
GEMINI_4_API_KEY=

# AURA AI — OpenRouter provider (server-only; same rules as above). Default
# AURA provider as of Phase 5. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# AgriNexus AI MVP-3C.0 — optional additional, genuinely independent
# OpenRouter credentials (each becomes its own endpoint in the Operator AURA
# Router, e.g. "openrouter-2"). Leave unset if you only have one OpenRouter
# key.
OPENROUTER_2_API_KEY=
OPENROUTER_3_API_KEY=
OPENROUTER_4_API_KEY=

# AURA AI — Groq provider (Phase 12; server-only, same rules as above). A
# second real provider, and the automatic fallback target when OpenRouter
# fails with a temporary/recoverable error (429, 5xx, or a network timeout —
# see lib/aura/providers/provider.ts's ProviderTemporaryError and
# app/api/aura/chat/route.ts). Get a key at https://console.groq.com/keys.
GROQ_API_KEY=

# AgriNexus AI MVP-3C.0 — optional additional, genuinely independent Groq
# credentials. A common real use: dedicate one Groq key to text chat and a
# second to Speech-to-Text (Whisper) so a busy conversational endpoint never
# competes with Voice AURA's own transcription quota — see
# lib/aura/router/model-catalog.ts's GROQ_CATALOG for the verified
# whisper-large-v3/-turbo models this makes possible. Leave unset if you
# only have one Groq key.
GROQ_2_API_KEY=
GROQ_3_API_KEY=
GROQ_4_API_KEY=

# Optional — overrides the model used specifically for the automatic
# OpenRouter→Groq fallback path (lib/aura/providers/groq-provider.ts's
# fallbackGroqModel()). Explicitly selecting Groq in AURA Settings uses
# GROQ_META's own model list instead, unaffected by this variable. Leave
# unset to use the built-in default.
GROQ_MODEL=

# Postgres connection string (server-only — read by apps/lib/prisma/client.ts,
# never sent to the browser). Shared with apps/backend's Prisma schema, which
# is the canonical source of the database schema (Prompt 018B). Get a free
# instant Postgres database with: npx create-db (run from apps/backend).
DATABASE_URL=

# Weather (Phase 11A) — real weather data comes from Open-Meteo
# (https://open-meteo.com), called server-only from
# lib/weather/weather-provider.ts. No API key/signup is required by this
# provider, so there is no WEATHER_API_KEY variable here — if a future
# phase swaps in a keyed provider (e.g. OpenWeatherMap), add ONE server-only
# key here (never NEXT_PUBLIC_, same rule as GEMINI_API_KEY/
# OPENROUTER_API_KEY above) and read it only inside weather-provider.ts.
#
# The farm's real-world location is read from Farm.latitude/Farm.longitude
# (nullable columns, see schema.prisma) — NOT an env var, since it's
# per-farm data, not a service credential. No farm in this seeded demo
# environment has a real location configured yet; the Weather page/AURA
# both show an honest "farm location not configured" state until one is
# set on the Farm row.
