# apps/backend holds the canonical Prisma schema and migrations. These
# variables are read by the Prisma CLI (migrate / generate / introspect)
# via prisma.config.ts. Copy this file to `.env` and fill in real values
# locally — never commit the filled-in file.

# Pooled Postgres connection string (used by the app runtime elsewhere in
# the monorepo, and kept here so schema tooling has a consistent value).
DATABASE_URL=

# Direct (non-pooled) Postgres connection string. prisma.config.ts uses
# this one for the Prisma CLI, because the schema engine can hang against a
# transaction-mode pooler. For a single non-pooled database, set it to the
# same value as DATABASE_URL.
DIRECT_URL=

# Optional — port for the (currently unwired) NestJS process. Defaults to 3000.
PORT=
